# Copy to .env and fill in.

# Project root on sys.path, so `from db import ...` resolves in any subpackage.
# PyCharm does this via "Add content roots to PYTHONPATH"; VS Code/Cursor needs it here.
PYTHONPATH=.

# https://console.groq.com/keys
GROQ_API_KEY=

# Used by db.py and alembic/env.py.
# e.g. postgresql+psycopg://user:password@localhost:5432/multi_persona_chatbot
POSTGRES_URL=
